{
  "name": "ivorie",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node tools/docs/build.ts && ng serve docs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:docs": "node dist/docs/server/server.mjs",
    "check": "node tools/check.ts",
    "docs:content": "node tools/docs/build.ts",
    "docs:build": "node tools/docs/build.ts && ng build docs && node tools/docs/postbuild.ts",
    "smoke:pack": "node tools/smoke/pack.ts",
    "smoke:cli": "node tools/smoke/cli-e2e.ts",
    "publish:all": "npm run check && npm publish ./dist/ui --access public && npm publish ./dist/cli --access public"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.4",
    "@lucide/angular": "^1.61.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@arethetypeswrong/cli": "^0.18.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "axe-core": "^4.14.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.3",
    "marked": "^18.1.2",
    "ng-packagr": "^22.2.5",
    "playwright-core": "^1.64.1",
    "publint": "^0.3.25",
    "shadcn": "^4.23.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
